# --- LLM (OpenAI-compatible) -------------------------------------------
# provider: openrouter | deepseek | openai | groq | custom
LLM_PROVIDER=deepseek
# OpenRouter: https://openrouter.ai/keys  (free models end with ":free")
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# legacy variables are still honored if LLM_* is absent
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Mail (SMTP) -------------------------------------------------------
# QQ mail: enable POP3/SMTP and use the 16-char authorization code (not the password)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_AUTH_CODE=
SMTP_FROM_NAME=ZeroNotice

PORT=8000

# --- Supabase (shared notices + per-user data) -------------------------
SUPABASE_URL=
# anon key: safe to ship in the desktop build (RLS protects rows)
SUPABASE_ANON_KEY=
# service_role key: owner only, used by scripts/sync_supabase.py (never ship)
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=attachments
SUPABASE_RETENTION_DAYS=30
